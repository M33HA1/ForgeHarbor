# ForgeHarbor local environment example
# Copy to config/.env and replace every placeholder.
# Never commit config/.env, real API keys, JWTs, or private keys.

# Provider keys
GEMINI_API_KEY=replace-me
VIRUSTOTAL_API_KEY=replace-me

# Database
MONGO_URI=mongodb://fh-mongo:27017
MONGO_DB=forgeharbor

# Cache and distributed Auth login throttling
REDIS_URL=redis://fh-redis:6379

# Message queue
RABBITMQ_URL=amqp://guest:guest@fh-rabbit:5672/
NOTIFY_QUEUE=notifications

# JWT settings
# Go control-plane and Rust analysis services use RSA key files, not JWT_SECRET.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=forgeharbor
JWT_AUDIENCE=forgeharbor-users

# Browser origins allowed by Auth, Phishing, and Malware (comma-separated).
# Set the deployed web origin explicitly for non-local environments.
CORS_ALLOWED_ORIGINS=http://localhost:8088,http://localhost:3000

# Object storage
S3_ENDPOINT=http://fh-minio:9000
S3_REGION=us-east-1
S3_BUCKET=forgeharbor-reports
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# MinIO aliases used by some local tooling
MINIO_ENDPOINT=fh-minio:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me

# Service ports
AUTH_PORT=8080
PHISHING_PORT=8081
MALWARE_PORT=8082
HISTORY_PORT=8083
REPORT_PORT=8084
NOTIFY_PORT=8085
SERVICE_PORT=8080

# Logging
RUST_LOG=debug
NODE_ENV=development

# Frontend (optional; leave blank to use the current origin through Traefik)
# VITE_API_BASE_URL=http://localhost:8088

# MCP credentials are not read from this file.
# Set OBSIDIAN_API_KEY and MDB_MCP_CONNECTION_STRING in your user environment.
