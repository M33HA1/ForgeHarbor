{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "github": {
        "type": "remote",
        "url": "https://api.githubcopilot.com/mcp/readonly",
        "headers": {
          "X-MCP-Toolsets": "repos,issues,pull_requests,actions"
        }
      },
      "obsidian": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "--package=node@24", "--package=@modelcontextprotocol/server-filesystem@2.1.0", "mcp-server-filesystem", "docs/obsidian"]
      },
      "source": {
        "type": "local",
        "command": ["cmd", "/c", "npx", "-y", "--package=node@24", "--package=@modelcontextprotocol/server-filesystem@2.1.0", "mcp-server-filesystem", "apps", "deploy", "scripts", "pkg"]
      },
      "mongodb": {
        "type": "local",
        "command": ["mongodb-mcp-server", "--readOnly"],
        "environment": {
          "MDB_MCP_CONNECTION_STRING": "{env:MDB_MCP_CONNECTION_STRING}"
        }
      }
    }
  }
}
